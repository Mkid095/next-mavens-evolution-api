# =============================================================================
# Evolution API - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and adjust for your setup:
#   cp env.example .env
#
# Container names from docker-compose.yaml:
#   postgres -> fidscript_postgres
#   redis    -> fidscript_redis
#   api      -> fidscript_api  (network alias: fidscript-whatsapp-api)
# =============================================================================

# ---------- Server ----------
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# ---------- CORS ----------
CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true

# ---------- Database ----------
# Service name is `fidscript-postgres` (compose service name); the
# container_name happens to use an underscore. Inter-container DNS
# resolves the service name on the shared fidscript-net network.
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://fidscript:fidscript@fidscript-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution

POSTGRES_DB=evolution
POSTGRES_USER=fidscript
POSTGRES_PASSWORD=fidscript

# ---------- Redis ----------
# Uses the alias declared on the redis service in docker-compose.yaml.
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://fidscript-redis:6379
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=86400

# ---------- Auth ----------
AUTHENTICATION_API_KEY=fidscript_evolution_key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ---------- Logs ----------
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error

# ---------- Instances ----------
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true

# ---------- Language ----------
LANGUAGE=en

# ---------- Webhook ----------
# Leave global webhook empty; configure per-instance so the platform can
# receive messages at /api/v1/channels/:id/webhook
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,422

# Per-event toggles (the ones the platform cares about)
WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_INSTANCE_CREATE=false
WEBHOOK_EVENTS_INSTANCE_DELETE=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
# All others default to false
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_EDITED=false
WEBHOOK_EVENTS_MESSAGES_UPDATE=false
WEBHOOK_EVENTS_MESSAGES_DELETE=false
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CHATS_DELETE=false

# ---------- WebSocket ----------
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true
WEBSOCKET_ALLOWED_HOSTS=

# ---------- Queue providers (off by default) ----------
RABBITMQ_ENABLED=false
RABBITMQ_GLOBAL_ENABLED=false
NATS_ENABLED=false
NATS_GLOBAL_ENABLED=false
SQS_ENABLED=false
SQS_GLOBAL_ENABLED=false
PUSHER_ENABLED=false
PUSHER_GLOBAL_ENABLED=false

# ---------- WhatsApp Business ----------
WA_BUSINESS_TOKEN_WEBHOOK=evolution
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v18.0
WA_BUSINESS_LANGUAGE=en

# ---------- Session ----------
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome

# ---------- QR Code ----------
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

# =============================================================================
# Platform Configuration (Phase 1)
# =============================================================================
# Platform-enabled deployment uses fidscript database (not evolution)

# ---------- Database ----------
# Note: Use /fidscript not /evolution for platform deployments
DATABASE_CONNECTION_URI=postgresql://fidscript:fidscript@localhost:5432/fidscript

# ---------- Platform Core ----------
PLATFORM_ENABLED=true
PLATFORM_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY_HERE
PLATFORM_IDEMPOTENCY_TTL_SECONDS=86400
PLATFORM_WEBHOOK_TIMEOUT_MS=5000
PLATFORM_WEBHOOK_MAX_RETRIES=5
PLATFORM_WEBHOOK_RETRY_BASE_DELAY_MS=1000
PLATFORM_OUTBOX_POLL_INTERVAL_MS=1000
PLATFORM_OUTBOX_BATCH_SIZE=10
PLATFORM_OUTBOX_MAX_RETRIES=3
PLATFORM_INTERNAL_API_KEY=CHANGE_ME_fidscript_internal_key

# ---------- Security ----------
TELEMETRY_ENABLED=false