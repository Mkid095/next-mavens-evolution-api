// ============================================================
// PLATFORM MODELS — Phase 1
// ============================================================

model PlatformAccount {
  id        String   @id @default(cuid())
  publicId  String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt

  users              PlatformUser[]
  apiKeys            PlatformApiKey[]
  subscriptions      PlatformSubscription[]
  rateLimitPolicies  PlatformRateLimitPolicy[]
  auditLogs          PlatformAuditLog[]
  usageRecords       PlatformUsageRecord[]
  idempotencyRecords PlatformIdempotencyRecord[]
  webhooks           PlatformWebhook[]
  instances          Instance[]
  platformInstances  PlatformInstance[]
  contacts           PlatformContact[]
  groups             PlatformGroup[]
  projects           PlatformProject[]

  @@index([status])
}

model PlatformUser {
  id           String    @id @default(cuid())
  publicId     String    @unique @db.VarChar(50)
  accountId    String
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @db.VarChar(255)
  role         String    @default("MEMBER")
  createdAt    DateTime  @default(now()) @db.Timestamp
  lastLoginAt  DateTime?
  name         String?   @db.VarChar(255)

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PlatformRateLimitPolicy {
  id                         String   @id @default(cuid())
  publicId                   String   @unique @db.VarChar(50)
  requestsPerMinute          Int      @default(100)
  messagesPerMinute          Int      @default(60)
  burstLimit                 Int      @default(45)
  webhookDeliveriesPerMinute Int      @default(500)
  maxInstances               Int      @default(1)
  maxActiveInstances         Int?
  createdAt                  DateTime @default(now()) @db.Timestamp

  platformPlans    PlatformPlan[]
  platformAccounts PlatformAccount[]

  @@map("PlatformRateLimitPolicy")
}

model PlatformPlan {
  id                  String   @id @default(cuid())
  publicId            String   @unique @db.VarChar(50)
  name                String   @unique @db.VarChar(100)
  displayName         String   @db.VarChar(100)
  monthlyMessageLimit Int?
  rateLimitPolicyId   String
  createdAt           DateTime @default(now()) @db.Timestamp

  rateLimitPolicy PlatformRateLimitPolicy @relation(fields: [rateLimitPolicyId], references: [id])
  subscriptions   PlatformSubscription[]

  @@map("PlatformPlan")
}

model PlatformSubscription {
  id        String    @id @default(cuid())
  publicId  String    @unique @db.VarChar(50)
  accountId String
  planId    String
  status    String    @default("active")
  startedAt DateTime  @default(now()) @db.Timestamp
  endsAt    DateTime?

  account PlatformAccount @relation(fields: [accountId], references: [id])
  plan    PlatformPlan    @relation(fields: [planId], references: [id])

  @@index([accountId])
  @@index([status])
}

model PlatformApiKey {
  id         String    @id @default(cuid())
  publicId   String    @unique @db.VarChar(50)
  accountId  String
  projectId      String
  keyHash    String    @unique @db.VarChar(64)
  keyPrefix  String    @db.VarChar(16)
  name       String?   @db.VarChar(255)
  scopes     Json      @default("[]")
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now()) @db.Timestamp

  account   PlatformAccount          @relation(fields: [accountId], references: [id])
  project       PlatformProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instances PlatformApiKeyInstance[]

  /// Set when this key is the default token of its project.
  defaultForProject PlatformProject? @relation("ProjectDefaultToken")

  @@index([accountId])
  @@index([projectId])
  @@index([keyHash])
}

model PlatformApiKeyInstance {
  id         String @id @default(cuid())
  apiKeyId   String
  instanceId String

  apiKey   PlatformApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  instance PlatformInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, instanceId])
  @@index([instanceId])
}

model PlatformIdempotencyRecord {
  id             String   @id @default(cuid())
  accountId      String
  apiKeyId       String
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.VarChar(64)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(255)
  status         String   @db.VarChar(20)
  response       Json?
  resourceId     String?  @db.VarChar(50)
  errorCode      String?
  createdAt      DateTime @default(now()) @db.Timestamp
  expiresAt      DateTime

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, apiKeyId, idempotencyKey])
  @@index([accountId, expiresAt])
}

model PlatformMessageCommand {
  id             String       @id @default(cuid())
  idempotencyKey String       @db.VarChar(128)
  accountId      String
  projectId          String
  instanceId     String
  apiKeyId       String
  messageId      String       @db.VarChar(50)
  type           String       @db.VarChar(50)
  recipient      String       @db.VarChar(128)
  content        Json
  status         String       @default("queued")
  attempts       Int          @default(0)
  lastError      String?      @db.Text
  engineRef      String?      @db.VarChar(255)
  sentAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now()) @db.Timestamp
  updatedAt      DateTime     @updatedAt

  project PlatformProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, instanceId, idempotencyKey])
  @@index([instanceId, status])
  @@index([accountId, createdAt])
  @@index([projectId])
}

model PlatformWebhook {
  id         String   @id @default(cuid())
  publicId   String   @unique @db.VarChar(50)
  accountId  String
  projectId      String
  instanceId String
  url        String   @db.VarChar(500)
  events     Json     @default("[]")
  secret     String   @db.VarChar(255)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamp
  updatedAt  DateTime @updatedAt

  account    PlatformAccount           @relation(fields: [accountId], references: [id])
  project        PlatformProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instance   PlatformInstance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  deliveries PlatformWebhookDelivery[]

  @@index([accountId])
  @@index([projectId])
  @@index([instanceId])
  @@index([enabled])
}

model PlatformWebhookDelivery {
  id             String    @id @default(cuid())
  publicId       String    @unique @db.VarChar(50)
  webhookId      String
  eventId        String    @db.VarChar(50)
  deliveryId     String    @db.VarChar(50)
  attempt        Int       @default(1)
  status         String    @db.VarChar(20)
  responseStatus Int?
  responseTimeMs Int?
  nextRetryAt    DateTime?
  lastError      String?   @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now()) @db.Timestamp

  webhook PlatformWebhook    @relation(fields: [webhookId], references: [id])
  events  InstanceEventLog[]

  @@unique([webhookId, eventId, attempt])
  @@index([webhookId, createdAt])
  @@index([eventId])
}

model PlatformInstance {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  publicId        String    @unique @db.VarChar(50)
  accountId       String    @db.VarChar(255)
  projectId           String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  status          String    @default("CREATED")
  phoneNumber     String?   @db.VarChar(20)
  capabilities    Json      @default("[]")
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now()) @db.Timestamp
  updatedAt       DateTime  @updatedAt

  account         PlatformAccount    @relation(fields: [accountId], references: [id])
  project             PlatformProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lifecycleEvents InstanceEventLog[]
  contacts        PlatformContact[]
  groups          PlatformGroup[]
  webhooks        PlatformWebhook[]
  apiKeyBindings  PlatformApiKeyInstance[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([projectId])
  @@index([accountId, projectId])
  @@index([status])
}

model InstanceEventLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  publicId   String   @unique @db.VarChar(50)
  instanceId String   @db.VarChar(255)
  eventType  String   @db.VarChar(100)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamp

  instance   PlatformInstance          @relation(fields: [instanceId], references: [id])
  deliveries PlatformWebhookDelivery[]

  @@index([instanceId, createdAt])
}

model PlatformContact {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  publicId        String    @unique @db.VarChar(50)
  accountId       String    @db.VarChar(255)
  projectId           String    @db.VarChar(255)
  instanceId      String    @db.VarChar(255)
  phoneNumber     String    @db.VarChar(20)
  /// The contact's WhatsApp address, e.g. 5511999999999@s.whatsapp.net.
  jid             String?   @db.VarChar(100)
  /// The contact's privacy-preserving LID, e.g. 123456789012345@lid.
  lid             String?   @db.VarChar(100)
  displayName     String?
  profilePhotoUrl String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now()) @db.Timestamp
  updatedAt       DateTime  @updatedAt

  account  PlatformAccount  @relation(fields: [accountId], references: [id])
  project      PlatformProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instance PlatformInstance @relation(fields: [instanceId], references: [id])

  @@unique([accountId, phoneNumber])
  @@index([accountId])
  @@index([projectId])
  @@index([instanceId])
}

model PlatformGroup {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  publicId         String   @unique @db.VarChar(50)
  accountId        String   @db.VarChar(255)
  projectId            String   @db.VarChar(255)
  instanceId       String   @db.VarChar(255)
  name             String   @db.VarChar(255)
  participantCount Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamp
  updatedAt        DateTime @updatedAt

  account    PlatformAccount          @relation(fields: [accountId], references: [id])
  project        PlatformProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instance   PlatformInstance         @relation(fields: [instanceId], references: [id])
  engineRefs PlatformGroupEngineRef[]

  @@index([accountId])
  @@index([projectId])
  @@index([instanceId])
}

model PlatformGroupEngineRef {
  id         String @id @default(dbgenerated("gen_random_uuid()"))
  groupId    String @db.VarChar(255)
  instanceId String @db.VarChar(255)
  provider   String @db.VarChar(50)
  groupJid   String @db.VarChar(100)

  group PlatformGroup @relation(fields: [groupId], references: [id])

  @@unique([instanceId, groupJid])
}

model PlatformUsageRecord {
  id             String   @id @default(cuid())
  accountId      String
  projectId          String
  instanceId     String?
  operation      String   @db.VarChar(100)
  resource       String   @db.VarChar(50)
  quantity       Int      @default(1)
  unit           String   @db.VarChar(20)
  idempotencyKey String?
  metadata       Json?
  periodStart    DateTime @db.Timestamp
  createdAt      DateTime @default(now()) @db.Timestamp

  account PlatformAccount @relation(fields: [accountId], references: [id])
  project     PlatformProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([accountId, periodStart])
  @@index([accountId, operation, periodStart])
  @@index([accountId, instanceId])
  @@index([projectId])
}

/// Encrypted application settings.
///
/// Holds secrets that must survive a redeploy but must never appear in
/// source control — currently the company gate password that protects
/// account creation. `value` always holds AES-256-GCM ciphertext
/// (`v1:<iv>:<authTag>:<ciphertext>`), never plaintext.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  accountId  String
  userId     String?
  apiKeyId   String?
  /// The project the event belongs to. Nullable: some events are not
  /// project-scoped (an account login, for instance). It is a plain
  /// column rather than a relation so an audit row survives the
  /// deletion of the project it referenced.
  projectId  String?  @db.VarChar(255)
  action     String   @db.VarChar(100)
  resource   String?  @db.VarChar(100)
  /// The affected resource. An API path is stored here for API_REQUEST
  /// events, and a path is longer than the 50 characters this column used
  /// to allow — which silently dropped every project-scoped request from
  /// the audit trail.
  resourceId String?  @db.VarChar(255)
  requestId  String?  @db.VarChar(50)
  eventId    String?  @db.VarChar(50)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  success    Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamp

  account PlatformAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([accountId, action])
  @@index([projectId, createdAt])
  @@index([requestId])
}

// ============================================================
// Project / App hierarchy — added in Phase 2 of the Viventure rebuild
// ============================================================

enum PlatformProjectStatus {
  ACTIVE
  ARCHIVED
}

model PlatformProject {
  id          String                @id @default(cuid())
  publicId    String                @unique @db.VarChar(50)
  accountId   String                @db.VarChar(255)
  name        String                @db.VarChar(100)
  slug        String                @db.VarChar(60)
  description String?               @db.VarChar(500)
  status      PlatformProjectStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @db.Timestamp
  updatedAt   DateTime              @updatedAt

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  defaultApiKey PlatformApiKey?   @relation("ProjectDefaultToken", fields: [defaultApiKeyId], references: [id], onDelete: SetNull)
  instances      PlatformInstance[]
  apiKeys        PlatformApiKey[]
  webhooks       PlatformWebhook[]
  contacts       PlatformContact[]
  groups         PlatformGroup[]
  messageCmds    PlatformMessageCommand[]
  usageRecords   PlatformUsageRecord[]

  /// The project's default API token, stored encrypted (AES-256-GCM) so the
  /// MCP and CLI install pages can show a working configuration at any time.
  /// `defaultApiKeyId` points at the PlatformApiKey row that enforces it.
  defaultApiKeyId       String?   @unique @db.VarChar(255)
  defaultTokenEncrypted String?   @db.Text
  defaultTokenPrefix    String?   @db.VarChar(20)
  defaultTokenCreatedAt DateTime? @db.Timestamp

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([accountId, status])
}

enum PlatformAppStatus {
  ACTIVE
  ARCHIVED
}
