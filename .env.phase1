# Database
DATABASE_CONNECTION_URI=postgresql://fidscript:fidscript_phase1_password@platform-postgres:5432/fidscript
DATABASE_PROVIDER=postgresql

# Redis
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://platform-redis:6379/6
CACHE_REDIS_PREFIX=platform:

# Server
SERVER_URL=http://localhost:8080
SERVER_PORT=8080
NODE_ENV=production

# Platform (Phase 1)
PLATFORM_ENABLED=true
# AES-256-GCM encryption key for webhook secrets (32 bytes = 64 hex chars)
PLATFORM_ENCRYPTION_KEY=eeead4b03128edbee26925b91194ab31defc7c6a42a6b87da9285b5320d712175
PLATFORM_IDEMPOTENCY_TTL_SECONDS=86400
PLATFORM_WEBHOOK_TIMEOUT_MS=30000
PLATFORM_WEBHOOK_MAX_RETRIES=5
PLATFORM_WEBHOOK_RETRY_BASE_DELAY_MS=1000
PLATFORM_OUTBOX_POLL_INTERVAL_MS=5000
PLATFORM_OUTBOX_BATCH_SIZE=20
PLATFORM_OUTBOX_MAX_RETRIES=5
# Internal API key for platform-to-platform communication
PLATFORM_INTERNAL_API_KEY=CHANGE_ME_GENERATE_with_openssl_rand_hex_32_chars

# Security hardening
TELEMETRY_ENABLED=false
CORS_ORIGIN=http://localhost:3000
AUTHENTICATION_API_KEY=CHANGE_ME_GENERATE_with_openssl_rand_hex_32_chars

# Branding (override defaults)
SERVER_NAME=Viventure
BRANDING_PRODUCT_NAME=Viventure
BRANDING_COMPANY_NAME=Viventure
